# DemocracyCraft Treasury API Key Configuration
#
# To obtain a key:
# 1. Complete the exam on the 4th floor of the School of Sociology and Economics.
# 2. In-game, run either:
#      /treasuryapi personal issue   (for personal accounts)
#      /treasuryapi business issue   (for business/firm accounts)
# 3. Paste the returned JWT token below:

TREASURY_API_KEY=
